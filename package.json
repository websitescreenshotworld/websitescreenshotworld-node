{
  "name": "@websitescreenshotworld/sdk",
  "version": "0.1.0",
  "description": "Node.js client for the Website Screenshot World Instant Snap and Auto Schedule APIs, with webhook verification",
  "keywords": [
    "screenshot",
    "website-screenshot",
    "web-capture",
    "pdf",
    "video",
    "webhooks",
    "websitescreenshotworld"
  ],
  "homepage": "https://github.com/websitescreenshotworld/websitescreenshotworld-node#readme",
  "bugs": {
    "url": "https://github.com/websitescreenshotworld/websitescreenshotworld-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websitescreenshotworld/websitescreenshotworld-node.git"
  },
  "license": "MIT",
  "author": "Silhouettec Solutions Private Limited <support@websitescreenshotworld.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test dist/test/test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
